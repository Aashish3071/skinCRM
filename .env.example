# ---------------------------------------------------------------------------
# SkinCRM environment. Copy to `.env` at the repo root: `cp .env.example .env`
# Every app reads this same root file (see packages/config/src/env.ts).
# Values below are safe LOCAL DEVELOPMENT defaults. Never reuse in production.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database -------------------------------------------------------------
# Owner role. Runs migrations and seeds. BYPASSES row-level security.
DATABASE_URL=postgresql://skincrm:skincrm_dev_password@localhost:5433/skincrm
# Application role. Subject to row-level security; used by api + worker at runtime.
# Created by `pnpm db:migrate` (see packages/db/sql/000_bootstrap_roles.sql).
DATABASE_APP_URL=postgresql://skincrm_app:skincrm_app_dev_password@localhost:5433/skincrm
DATABASE_APP_PASSWORD=skincrm_app_dev_password

# --- Redis (BullMQ queues) ------------------------------------------------
REDIS_URL=redis://localhost:6380

# --- Ports ----------------------------------------------------------------
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Base URL clients reach. Used for unsubscribe and self-service links.
PUBLIC_WEB_URL=http://localhost:3000

# --- Secrets --------------------------------------------------------------
# Generate each with: openssl rand -base64 32
SESSION_SECRET=dev_only_session_secret_change_me_0000000000
# Root key for envelope-encrypting per-clinic provider credentials.
# In production use a KMS: set CRYPTO_PROVIDER=aws-kms and KMS_KEY_ID.
CRYPTO_PROVIDER=local
CRYPTO_MASTER_KEY=dev_only_master_key_change_me_000000000000
# KMS_KEY_ID=
# CRYPTO_PROVIDER=aws-kms: the root key exists only wrapped by KMS (pnpm crypto:new-key).
CRYPTO_WRAPPED_KEY=
# After a rotation: old keys, decrypt-only, comma-separated, until pnpm db:rotate-keys reports none left.
CRYPTO_PREVIOUS_WRAPPED_KEYS=
CRYPTO_PREVIOUS_MASTER_KEYS=

# --- Connector mode -------------------------------------------------------
# `mock` keeps every outbound call in-process and logged to the DB.
# Switch an individual connector to `live` only after its credentials exist.
CONNECTOR_EMAIL=mock
CONNECTOR_WHATSAPP=mock
CONNECTOR_META=mock
CONNECTOR_GOOGLE=mock
CONNECTOR_CALENDAR=mock

# Hard global kill switch. When false, NO outbound message or ad-platform event
# leaves the process regardless of per-connector settings. Keep false until the
# clinic signs off on message copy and privacy settings.
OUTBOUND_SENDING_ENABLED=false
# Separate, stricter switch for CRM -> ad-platform conversion feedback (PRD FB-03).
# Must stay false until per-destination eligibility checks pass.
CONVERSION_FEEDBACK_ENABLED=false

# --- Background worker ----------------------------------------------------
# Runs automation steps and housekeeping. In development the API runs it
# in-process; in production start `node apps/api/dist/worker.js` separately.
WORKER_IN_API=true
WORKER_POLL_MS=5000

# --- Email provider (only read when CONNECTOR_EMAIL=live) -----------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=noreply@example-clinic.test
EMAIL_FROM_NAME=Example Clinic

# --- Meta (Lead Ads + WhatsApp Cloud API + Conversions API) ---------------
# Per-clinic tokens live encrypted in the DB. These are the APP-level values.
META_APP_ID=
META_APP_SECRET=
# Optional: a Facebook Login for Business configuration id (Connect with Facebook).
META_LOGIN_CONFIG_ID=
# WhatsApp Embedded Signup configuration id (Connect WhatsApp, CONNECTOR_WHATSAPP=live).
META_WA_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=dev_meta_verify_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=dev_whatsapp_verify_token

# --- Google Ads lead-form webhook ----------------------------------------
# Each lead form carries its own `google_key`; stored per-form in the DB.
# This is only the fallback used by the seeded demo form.
GOOGLE_LEAD_FORM_KEY=dev_google_key
# Connect with Google Ads: enable Ads API + Data Manager API on the OAuth Cloud project.
# Consent scopes: adwords and datamanager. Reconnect existing accounts for the added scope.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional legacy setting; access now comes from the OAuth Cloud project.
GOOGLE_ADS_DEVELOPER_TOKEN=

# --- Observability --------------------------------------------------------
# Operational alerts (queue backlog, webhook failures, silent sources, email
# failures, missed backups) are emailed here every few minutes while they last.
# OPS_ALERT_EMAIL=ops@yourcompany.com
# For an external uptime monitor: GET /health/alerts with header x-monitor-token.
# MONITOR_TOKEN=generate-with-openssl-rand-base64-32
BACKUPS_EXPECTED=false
RAW_PAYLOAD_RETENTION_DAYS=90
LOG_LEVEL=debug
# SENTRY_DSN=

# --- Legal pages (/privacy, /terms) — who publishes SkinCRM -----------------
LEGAL_ENTITY_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_ADDRESS=
