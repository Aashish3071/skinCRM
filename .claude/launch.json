{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@skincrm/api",
        "dev"
      ],
      "port": 4000
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@skincrm/web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "web-3100",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@skincrm/web",
        "exec",
        "next",
        "dev",
        "-p",
        "3100"
      ],
      "port": 3100
    }
  ]
}