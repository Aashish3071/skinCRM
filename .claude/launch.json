{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@skincrm/api",
        "dev"
      ],
      "port": 4000
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@skincrm/web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "web-3100",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@skincrm/web",
        "exec",
        "next",
        "dev",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "api-audit",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DATABASE_URL=postgresql://skincrm:skincrm_dev_password@localhost:5433/skincrm_full",
        "DATABASE_APP_URL=postgresql://skincrm_app:skincrm_app_dev_password@localhost:5433/skincrm_full",
        "WORKER_IN_API=true",
        "pnpm",
        "--filter",
        "@skincrm/api",
        "dev"
      ],
      "port": 4000
    },
    {
      "name": "web-prod-3200",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@skincrm/web",
        "exec",
        "next",
        "start",
        "-p",
        "3200"
      ],
      "port": 3200
    }
  ]
}